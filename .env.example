PORT=5000
NODE_ENV=development

# Orígenes permitidos para el navegador (allowlist, separados por coma).
# En producción es obligatorio definirla y no se aceptan comodines.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# HTTPS y proxy inverso.
# En producción: FORCE_HTTPS=true, TRUST_PROXY=true, COOKIE_SECURE=true.
FORCE_HTTPS=false
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Cookies de sesión httpOnly.
COOKIE_SECURE=false
# Usa "none" solo si frontend y API están en dominios distintos (requiere HTTPS).
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=55
REFRESH_TTL_DAYS=30

# Registro público deshabilitado: las cuentas se crean en Supabase.
ENABLE_PUBLIC_SIGNUP=false

# Registro de eventos de seguridad.
SECURITY_LOG_FILE=logs/security.log
# Guarda también los eventos en public.security_events (requiere security_hardening.sql).
SECURITY_DB_LOG=false

# Proyecto Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Bucket privado para comprobantes
SUPABASE_STORAGE_BUCKET=comprobantes

# Mensualidad y cobros automáticos
MONTO_MENSUALIDAD=500
COBROS_CRON=10 0 * * *
COBROS_TZ=America/Bogota

# Recordatorios por correo (opcional, desactivado por defecto)
ENABLE_REMINDERS=false
REMINDERS_CRON=0 9 * * *
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Club Deportivo Yokohama
