{
  "info": "Ejemplos de requests para el backend Supabase de Club Yokohama",
  "baseUrl": "http://localhost:5000/api",
  "auth": {
    "nota": "Las rutas protegidas requieren Authorization: Bearer <access_token>. El token se obtiene en /auth/login o /auth/signup.",
    "admin": "El usuario debe tener role='admin' en public.profiles."
  },
  "endpoints": [
    {
      "nombre": "Registro",
      "metodo": "POST",
      "url": "http://localhost:5000/api/auth/signup",
      "headers": { "Content-Type": "application/json" },
      "body": {
        "email": "alumno@example.com",
        "password": "password123",
        "nombre": "Juan Pérez"
      }
    },
    {
      "nombre": "Login",
      "metodo": "POST",
      "url": "http://localhost:5000/api/auth/login",
      "headers": { "Content-Type": "application/json" },
      "body": {
        "email": "alumno@example.com",
        "password": "password123"
      }
    },
    {
      "nombre": "Verificar sesión",
      "metodo": "GET",
      "url": "http://localhost:5000/api/auth/verify",
      "headers": { "Authorization": "Bearer <access_token>" }
    },
    {
      "nombre": "Mi ficha de alumno",
      "metodo": "GET",
      "url": "http://localhost:5000/api/alumnos/me",
      "headers": { "Authorization": "Bearer <access_token>" },
      "nota": "Si el alumno no existe, se crea automáticamente. Si hay una ficha sin cuenta con el mismo correo, se vincula."
    },
    {
      "nombre": "Listar alumnos (admin)",
      "metodo": "GET",
      "url": "http://localhost:5000/api/alumnos?grupo=BABY&activo=true",
      "headers": { "Authorization": "Bearer <admin_access_token>" }
    },
    {
      "nombre": "Crear alumno (admin)",
      "metodo": "POST",
      "url": "http://localhost:5000/api/alumnos",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <admin_access_token>"
      },
      "body": {
        "nombre": "Emiliano Cruz",
        "correo": "emiliano@example.com",
        "telefono": "3001234567",
        "edad": 6,
        "direccion": "Calle 1 # 2-3",
        "grupo": "BABY",
        "cinturon": "BLANCO",
        "activo": true
      }
    },
    {
      "nombre": "Listar pagos (admin)",
      "metodo": "GET",
      "url": "http://localhost:5000/api/pagos?estado=pendiente&mes=2026-11",
      "headers": { "Authorization": "Bearer <admin_access_token>" }
    },
    {
      "nombre": "Crear pago (admin)",
      "metodo": "POST",
      "url": "http://localhost:5000/api/pagos",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <admin_access_token>"
      },
      "body": {
        "alumno_id": "<uuid-del-alumno>",
        "mes": "2026-11",
        "monto": 500,
        "estado": "pendiente"
      }
    },
    {
      "nombre": "Marcar pago como pagado (admin)",
      "metodo": "PATCH",
      "url": "http://localhost:5000/api/pagos/<uuid-del-pago>",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <admin_access_token>"
      },
      "body": {
        "estado": "pagado",
        "fecha_pago": "2026-11-04"
      }
    },
    {
      "nombre": "Subir comprobante (alumno)",
      "metodo": "POST",
      "url": "http://localhost:5000/api/pagos/<uuid-del-pago>/comprobante",
      "headers": { "Authorization": "Bearer <access_token>" },
      "body": "multipart/form-data con el campo comprobante (JPG, PNG, WEBP o PDF, máximo 5 MB)"
    },
    {
      "nombre": "Dashboard admin",
      "metodo": "GET",
      "url": "http://localhost:5000/api/dashboard",
      "headers": { "Authorization": "Bearer <admin_access_token>" }
    },
    {
      "nombre": "Dashboard alumno",
      "metodo": "GET",
      "url": "http://localhost:5000/api/dashboard/me",
      "headers": { "Authorization": "Bearer <access_token>" }
    }
  ]
}
